  "description": "Local deterministic memory for AI agents via MCP. Deterministic xLMP lexical retrieval, stdio transport, Claude Desktop compatible.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "vanguard-memory-node": "dist/index.js"
  },
  "files": [
    "dist/",
    "src/",
    "INSTALL.md",
    "README.md"
  ],
  "scripts": {
