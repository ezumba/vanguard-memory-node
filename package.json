    "test": "node tests/regression_suite.mjs",
    "prepublishOnly": "npm run build && npm test",
    "start": "tsc && node dist/index.js",
    "dev": "node dist/index.js"
  },
  "keywords": [
    "mcp",
    "memory",
    "ai",
    "claude",
    "local",
    "deterministic",
    "xlmp"
